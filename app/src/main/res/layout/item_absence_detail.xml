<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/dateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/seanceTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Séance"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/justificatifTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Justificatif"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/penaliteTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pénalité"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/editButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Modifier"
                android:textColor="#FFFFFF"
                android:backgroundTint="#007BFF"
                app:cornerRadius="4dp"
                app:iconTint="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/deleteButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Supprimer"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF4444"
                app:cornerRadius="4dp"
                app:iconTint="#FFFFFF"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/viewJustificatifButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voir justificatif"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007BFF"
            app:cornerRadius="4dp"
            android:layout_marginTop="8dp"
            app:icon="@drawable/ic_file"
            app:iconTint="#FFFFFF"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>