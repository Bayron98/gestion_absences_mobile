<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Titre -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Absences par Matière"
        android:textSize="24sp"
        android:textColor="#007BFF"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Spinner pour choisir une matière -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Choisir une matière"
        app:boxStrokeColor="#007BFF"
        app:hintTextColor="#007BFF"
        android:layout_marginBottom="16dp">

        <Spinner
            android:id="@+id/matiereSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#007BFF"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- RecyclerView pour les étudiants -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/etudiantsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Bouton Déconnexion -->
    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/button_rounded_logout"
        android:text="DÉCONNEXION"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:drawablePadding="8dp"
        android:elevation="2dp"/>
</LinearLayout>